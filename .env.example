# AI Provider Configuration (OpenAI-compatible chat completions)
# Keys: Groq keys typically start with 'gsk_', xAI keys with 'xai-'
# Never commit real keys or secrets to git.
AI_API_KEY=

# Model ID: AI_MODEL has no default. Copy the exact model ID from your provider's model list
# (e.g. llama-3.3-70b-versatile or llama-3.1-8b-instant for Groq). Expect models to be retired or updated from time to time.
AI_MODEL=

# Optional: Defaults to https://api.groq.com/openai/v1 if unset or empty.
# Allowlisted hosts: api.groq.com, api.x.ai
AI_BASE_URL=https://api.groq.com/openai/v1

# Note for Vercel Deployments:
# Environment variables must be configured in Vercel Project Settings for both Production and Preview environments.
# Any change to environment variables in Vercel requires a redeployment (Deployments -> ... -> Redeploy) to take effect.

# Optional GitHub Token to increase rate limits for public repository analysis
GITHUB_TOKEN=

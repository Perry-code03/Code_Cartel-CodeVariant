# AI Provider Configuration (OpenAI-compatible chat completions)
# Groq keys typically start with 'gsk_', xAI keys with 'xai-'
AI_API_KEY=
AI_MODEL=
# Optional: Defaults to https://api.groq.com/openai/v1 if unset. Allowlist: api.groq.com, api.x.ai
AI_BASE_URL=https://api.groq.com/openai/v1

# Optional GitHub Token to increase rate limits for public repository analysis
GITHUB_TOKEN=
